{
  "name": "kinetube-backend",
  "version": "2.1.1",
  "private": true,
  "description": "Local Express API for KineTube: downloads, transcription and tool setup",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/unzipper": "^0.10.11",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2"
  }
}
