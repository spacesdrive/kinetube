{
  "version": 1,
  "id": "youtube-channel",
  "title": "A channel's Live tab",
  "description": "The Live tab of a channel in the dark theme, with live, upcoming and past streams. The camera starts close and pulls back.",
  "definition": {
    "scene": {
      "version": 3,
      "camera": {
        "x": 0,
        "y": 0,
        "z": 0,
        "perspective": 1400,
        "rotateX": 10,
        "rotateY": -16,
        "rotateZ": 0
      },
      "focus": {
        "distance": 1400,
        "fStop": 5.6,
        "focalLength": 50,
        "maxBlur": 6
      },
      "nodes": [
        {
          "id": "page",
          "transform": {
            "x": 0,
            "y": 0,
            "z": 0,
            "rotateX": 0,
            "rotateY": 0,
            "rotateZ": 0,
            "scale": 1
          }
        }
      ]
    },
    "motion": {
      "durationMs": 3500,
      "speed": 0.5,
      "tracks": [
        {
          "target": {
            "kind": "camera"
          },
          "property": "z",
          "keyframes": [
            {
              "timeMs": 0,
              "value": -420,
              "easing": "cinematic"
            },
            {
              "timeMs": 3500,
              "value": 40,
              "easing": "cinematic"
            }
          ]
        },
        {
          "target": {
            "kind": "camera"
          },
          "property": "x",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 120,
              "easing": "cinematic"
            },
            {
              "timeMs": 3500,
              "value": -40,
              "easing": "cinematic"
            }
          ]
        },
        {
          "target": {
            "kind": "camera"
          },
          "property": "y",
          "keyframes": [
            {
              "timeMs": 0,
              "value": -60,
              "easing": "cinematic"
            },
            {
              "timeMs": 3500,
              "value": 40,
              "easing": "cinematic"
            }
          ]
        }
      ]
    },
    "width": 1600,
    "height": 1000
  }
}
