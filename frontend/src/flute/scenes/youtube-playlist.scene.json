{
  "version": 1,
  "id": "youtube-playlist",
  "title": "Picking videos from a playlist",
  "description": "A playlist in the light theme. Rows are ticked one by one while the camera moves down the list.",
  "definition": {
    "scene": {
      "version": 3,
      "camera": {
        "x": -40,
        "y": 0,
        "z": 0,
        "perspective": 1400,
        "rotateX": 16,
        "rotateY": 16,
        "rotateZ": 0
      },
      "focus": {
        "distance": 1300,
        "fStop": 5.6,
        "focalLength": 50,
        "maxBlur": 6
      },
      "nodes": [
        {
          "id": "page",
          "transform": {
            "x": 0,
            "y": 0,
            "z": 0,
            "rotateX": 0,
            "rotateY": 0,
            "rotateZ": 0,
            "scale": 1
          }
        }
      ]
    },
    "motion": {
      "durationMs": 3500,
      "speed": 0.5,
      "tracks": [
        {
          "target": {
            "kind": "camera"
          },
          "property": "y",
          "keyframes": [
            {
              "timeMs": 0,
              "value": -120,
              "easing": "cinematic"
            },
            {
              "timeMs": 3500,
              "value": 140,
              "easing": "cinematic"
            }
          ]
        }
      ]
    },
    "width": 1600,
    "height": 1000
  }
}
