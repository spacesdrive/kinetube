{
  "name": "kinetube",
  "version": "1.6.0",
  "description": "Local YouTube & Instagram downloader",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -n backend,frontend,electron -c cyan,magenta,yellow \"cd backend && node --watch src/server.ts\" \"cd frontend && npx vite\" \"wait-on http://127.0.0.1:3001/health http://localhost:5173 && node scripts/run-electron.mts\"",
    "typecheck": "tsc -b shared electron && cd backend && npm run typecheck && cd ../frontend && npm run typecheck",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "build:electron": "tsc -b electron",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build && npm prune --omit=dev",
    "build": "npm run build:electron && npm run build:frontend && npm run build:backend",
    "postinstall": "node scripts/patch-7zip.mts",
    "dist": "npm run build && npx electron-builder --publish never",
    "dist:win": "npm run build && npx electron-builder --win --publish never",
    "dist:mac": "npm run build && npx electron-builder --mac --publish never",
    "dist:linux": "npm run build && npx electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.kinetube.app",
    "productName": "KineTube",
    "copyright": "Copyright © 2025 KineTube",
    "asar": false,
    "publish": {
      "provider": "github",
      "owner": "spacesdrive",
      "repo": "kinetube",
      "releaseType": "release"
    },
    "files": [
      "electron/dist/**/*",
      "electron/loading.html"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.env",
          "!src/**",
          "!tests/**",
          "!tsconfig*.json",
          "!*.tsbuildinfo",
          "!python/__pycache__/**",
          "!pending-downloads.json",
          "!sessions/**",
          "!downloads/*.exe",
          "!downloads/*.dll",
          "!downloads/*.zip",
          "!downloads/*.bin",
          "!downloads/*.mp4",
          "!downloads/*.webm",
          "!downloads/*.mkv",
          "!downloads/*.mp3",
          "!downloads/*.m4a",
          "!models/**"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KineTube",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "~6.0.2",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "unzipper": "^0.12.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
